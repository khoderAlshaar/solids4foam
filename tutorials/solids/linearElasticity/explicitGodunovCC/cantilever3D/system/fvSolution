FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

angularMomentumConservation    yes;
incompressiblilityCoefficient   1.0;
dampingCoeff  dampingCoeff [ 0 0 -1 0 0 0 0 ] 12.5;

//solid4foam settings:


solvers
{
    // Coupled solver
    "blockDD|blockD"
    {
        // Direct solver
        solver              EigenSparseLU;

        // Iterative solver
        //solver            BiCGStab;
        //preconditioner    myCholesky;
        //tolerance         1e-10;
        //relTol            0;
        //minIter           0;
        //maxIter           1000;
    }

    // Segregated solver
    "D|DD"
    {
        tolerance       1e-8;
        relTol          0.1;
        maxIter         50;

        solver          PCG;
        preconditioner  FDIC;
    }
}

relaxationFactors
{
    equations
    {
        //D           0.9999;
    }

    fields
    {
        //D              0.9;
    }
}





