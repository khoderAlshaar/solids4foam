multiStage
{
    numberSubCycles 10000;
    tolerance 1e-4;
    relTol 1e-4;
    infoFrequency      100;
    pseudoStagnationTol 1e-12;
    pseudoStagnationLimit 10;
  }


relaxationFactors
{
    // Note: under-relaxation factors used in wave-transmissive schemes
    k             0.2;
    omega         0.2;
}

fieldBounds
{
    // With bounding
    p      1e-6     1e6;
    rho    1e-6     1e6;
    h      1e-6     1e6;
    e      1e-6     1e6;
    rhoE   1e-6     1e6;
    T      1e-6    3000;
    U    1000;
}
