defaultFieldValues
(
    volScalarFieldValue p 0.1e6
    volVectorFieldValue U (0 0 0)
    volScalarFieldValue T 300
);

regions
(
    boxToCell
    {
        box (0 0 0) (2.0 0.1 0.1);

        fieldValues
        (
            volScalarFieldValue p 1e6
        );
    }
