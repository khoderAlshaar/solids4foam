libs
(

        "libExtStiffenedGas.so"


)

libExtStiffenedGas

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.00075;

deltaT          0.000001;

writeControl    runTime;

writeInterval   0.00005;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression no;

timeFormat      general;

timePrecision   6;

graphFormat     raw;

runTimeModifiable yes;

adjustTimeStep  no;

